<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Captain Memo worker — macOS LaunchAgent (per-user, no root).

  Parity notes against the systemd unit next door:
    Restart=always        -> KeepAlive <true/>   (relaunch on ANY exit, clean or not)
    RestartSec=5          -> ThrottleInterval    (launchd's floor is 10s; it refuses
                                                  to relaunch faster and logs if you try)
    EnvironmentFile=      -> nothing. launchd has NO equivalent, and it does not need
                             one: the worker calls loadWorkerEnv() itself at startup
                             (src/worker/index.ts) and reads CONFIG_DIR/worker.env on
                             every platform. Same arrangement the Windows task uses.
    StandardOutput=journal-> StandardOutPath. macOS has no journal, so logs are files;
                             read them with `log show` or just `tail -f`.

  Placeholders are substituted by src/services/service-manager/launchd.ts.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
__PROGRAM_ARGS__
  </array>

  <key>WorkingDirectory</key>
  <string>__INSTALL_DIR__</string>

  <!-- Start at login, and keep it up. Deliberately unconditional KeepAlive rather than
       {SuccessfulExit: false}: the worker exiting 0 is still an outage, exactly as
       Restart=always treats it on Linux. Stop is `bootout`, which unloads the job
       outright, so KeepAlive cannot resurrect a service the operator stopped. -->
  <key>RunAtLoad</key>
  __RUN_AT_LOAD__
  <key>KeepAlive</key>
  __KEEP_ALIVE__

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/__NAME__.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/__NAME__.err.log</string>

  <!-- Background: normal scheduling priority and I/O throttling appropriate for a
       daemon. Without it launchd may treat the job as interactive. -->
  <key>ProcessType</key>
  <string>Background</string>

  <!-- Attribution in System Settings > General > Login Items & Extensions.
       macOS names a background item after the CODE-SIGNING IDENTITY of the program it
       runs. Ours is `bun`, so the notification reads "software by Jarred Sumner can run
       in the background" — accurate, and completely unhelpful to someone who installed
       Captain Memo (reported by a user 2026-07-28).

       AssociatedBundleIdentifiers is Apple's hook for re-attributing a job to an app.
       HONEST LIMIT: it only fully re-labels the entry when a bundle with that identifier
       is installed AND signed by the same team; with no signed Captain Memo bundle macOS
       may still fall back to Bun's signature. Declaring it costs nothing, is correct the
       moment a signed bundle ships, and makes the intent explicit either way. -->
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>com.captainmemo.worker</string>
  </array>
</dict>
</plist>
