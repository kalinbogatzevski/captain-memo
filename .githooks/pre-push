#!/usr/bin/env bash
# ── PRE-PUSH MOAT HOOK ─────────────────────────────────────────────────────────
# Refuse to push federation code to github. The `federation` branch and any commit touching
# src/worker/federation/ are gitlab-private ONLY; github gets the OSS, federation-free `master`.
# Install: git config core.hooksPath .githooks
#
# The check judges the COMMIT a ref points at, never the ref's name or the working tree. A tag called v0.58.6 that
# pointed at a federation commit once published 1347 federation commits (2026-10-23): this hook then only matched the
# names `*/federation` and `fed-v*`, and for a NEW ref it ran `git diff <sha>`, which compares the sha with the working
# tree, so it found nothing whenever the push was started from the federation checkout.
set -eo pipefail

remote_url="$2"
echo "$remote_url" | grep -qi github || exit 0   # only guard pushes to github

ZERO=0000000000000000000000000000000000000000
FED_DIR=src/worker/federation
block() { echo "✗ BLOCKED: $1"; exit 1; }

while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                       # a deletion publishes nothing
  case "$local_ref" in
    */federation) block "refusing to push the federation branch to github ($remote_url)." ;;
    refs/tags/fed-v*) block "refusing to push the fed release tag ${local_ref#refs/tags/} to github ($remote_url): it points at federation commits." ;;
  esac
  # Peel an annotated tag to its commit. A ref to anything else (a tag of a tree or a blob) cannot be judged by path, and nothing
  # legitimate pushes one to github, so it is refused rather than waved through.
  commit=$(git rev-parse --verify -q "$local_sha^{commit}") \
    || block "$local_ref ($local_sha) is not a commit (a tag of a tree or a blob): its content cannot be judged, so it is not pushed to github ($remote_url)."
  # 1. The tip itself: no ref, whatever its name, may point at a tree that carries federation code.
  if [ -n "$(git ls-tree -r --name-only "$commit" -- "$FED_DIR" | head -1)" ]; then
    block "$local_ref ($commit) carries $FED_DIR/: federation code is gitlab-private only ($remote_url)."
  fi
  # 2. The whole history behind it, every commit and both sides of every merge (`git log -- dir` follows ONE parent of a merge that
  #    is unchanged for the dir, so it can skip the side that added federation code). Not limited to "what the remote lacks": that
  #    needs a local remote-tracking ref, which can be stale or hand-made. OSS history never touched the dir, so this costs
  #    ~0.2 s and has no false positives on a legitimate push.
  if [ -n "$(git rev-list "$commit" | git diff-tree --stdin -r -m --root --name-only --no-commit-id -- "$FED_DIR" | head -1)" ]; then
    block "the history behind $local_ref ($remote_url) touches $FED_DIR/ in some commit: federation code is gitlab-private only."
  fi
done
exit 0
