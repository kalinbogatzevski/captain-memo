[Unit]
Description=Captain Memo worker (user-level, HTTP search + observation pipeline)
# NO After=default.target here: the unit is WantedBy=default.target, and the two together
# close an ordering cycle as soon as any other user unit is ordered after this one —
# systemd breaks the cycle by DELETING this unit's start job, silently. That kept an install
# offline for two days after a reboot (2026-08-28).
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=-__ENV_FILE__
ExecStart=__BUN__ src/worker/index.ts
Restart=always
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
