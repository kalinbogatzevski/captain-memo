[Unit]
Description=Captain Memo embedder sidecar (user-level, voyage-4-nano via FastAPI)
# NO After=default.target here: the unit is WantedBy=default.target, and the two together
# close an ordering cycle as soon as any other user unit is ordered after this one —
# systemd breaks the cycle by DELETING this unit's start job, silently. That kept an install
# offline for two days after a reboot (2026-08-28).
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
Environment="PATH=__INSTALL_DIR__/venv/bin:/usr/bin:/bin"
Environment="HF_HOME=__INSTALL_DIR__/models"
ExecStart=__INSTALL_DIR__/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8124 --log-level info
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
