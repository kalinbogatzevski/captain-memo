node_modules
bun.lockb
dist/
# plugin/dist holds the committed, self-contained plugin entrypoints (bundled
# from src/bin so a git checkout/install works on Windows without symlinks).
!plugin/dist/
!plugin/dist/**
.captain-memo/
.captain-memo.dev/
*.tsbuildinfo
.DS_Store
*.log

# Ad-hoc Windows session reports — generated locally, not part of the repo.
WINDOWS_INSTALL_REPORT.md
WINDOWS_SMOKE_TEST_v0.2.14.md

# Local-only symlink (plugin/bin -> ../bin). Never commit: it breaks on Windows
# checkouts. The committed, symlink-free entrypoints live in plugin/dist/ (above).
plugin/bin

# SDD scratch
.superpowers/

# Python bytecode. On Windows the embedder task runs from services/embed in this checkout, so Python writes an
# untracked __pycache__ there, and the opt-in self-updater (src/worker/self-updater.ts) refuses a dirty tree.
__pycache__/
*.pyc
